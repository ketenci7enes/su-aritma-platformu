# ── Supabase ─────────────────────────────────────────────────────────────
# Supabase projesi bağlanınca doldurulur. Boş bırakılırsa uygulama DEMO MOD'da
# çalışır: veri tarayıcıda (localStorage), ödeme mock, otomasyon console log.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Ödeme ────────────────────────────────────────────────────────────────
